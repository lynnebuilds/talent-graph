# =============================================================================
# TalentGraph - 环境变量配置模版
# 复制此文件为 .env 并按需填写配置: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 核心 LLM 配置 (官方 DeepSeek + 多中转站按需切换 + 自动降级兜底)
# -----------------------------------------------------------------------------
# 默认激活渠道: "deepseek" (官方默认) | "relay_a" | "relay_b" | ... | "mock"
# 说明:
# - 支持按需配置任意多个中转站组 (RELAY_<NAME>_BASE_URL / API_KEY / MODEL)
# - 若所选中转站配置缺失或运行时重试耗尽，系统自动打印 WARNING 并降级回官方 DeepSeek
LLM_PROVIDER=deepseek

# 官方 DeepSeek API (同时作为中转站故障时的默认兜底渠道)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 默认使用 deepseek-flash，可按需覆盖为 deepseek-chat 等模型
DEEPSEEK_MODEL=deepseek-flash

# 并发、超时与重试控制
LLM_MAX_CONCURRENCY=20
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# 多中转站配置示例 (OpenAI 兼容协议，按需取消注释并填写真实地址与密钥)
# 使用方式: 将 LLM_PROVIDER 设为 relay_a / relay_b，或通过 CLI `--provider relay_a` / API `llm_provider` 临时指定
#
# 中转站 A (选择名: relay_a)
# RELAY_A_BASE_URL=https://relay-a.example.com/v1
# RELAY_A_API_KEY=sk-your-relay-a-key
# RELAY_A_MODEL=deepseek-chat
#
# 中转站 B (选择名: relay_b)
# RELAY_B_BASE_URL=https://relay-b.example.com/v1
# RELAY_B_API_KEY=sk-your-relay-b-key
# RELAY_B_MODEL=deepseek-flash

# -----------------------------------------------------------------------------
# 2. 向量计算配置 (纯 CPU 本地 ONNX 默认 + 通用 OpenAI 兼容 API 可选)
# -----------------------------------------------------------------------------
# 向量提供者: "onnx" (纯 CPU 本地 ONNX 推理, 默认零外部依赖) | "api" (OpenAI 兼容 Embedding API)
EMBEDDING_PROVIDER=onnx
# ONNX 向量模型名称或本地路径
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量计算批处理大小
EMBEDDING_BATCH_SIZE=32

# 通用 OpenAI 兼容 Embedding API 配置 (仅当 EMBEDDING_PROVIDER=api 时生效)
# EMBEDDING_API_BASE_URL=https://api.example.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# 3. 算法与流水线配置
# -----------------------------------------------------------------------------
# 节点语义相似度命中阈值 (0.0 ~ 1.0)
NODE_SIMILARITY_THRESHOLD=0.85
# 题库标准图谱缓存目录
CORPUS_CACHE_DIR=./data/cache/corpus
# 评测输出根目录
OUTPUT_DIR=./data/output

# -----------------------------------------------------------------------------
# 4. 服务与 API 配置
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 跨域允许源 (逗号分隔，或 * 表示全部)
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# 5. Playwright 内置无头浏览器 PDF 导出配置
# -----------------------------------------------------------------------------
# 是否启用 PDF 导出
PDF_EXPORT_ENABLED=true
# PDF 渲染超时时间 (毫秒)
PDF_TIMEOUT_MS=30000
# 页面渲染等待选择器
PDF_WAIT_UNTIL=networkidle
